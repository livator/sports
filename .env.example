# Copy to apps/web/.env (shared settings) or apps/web/.env.local (secrets). Both are git-ignored.

# ---------- Sports data ----------
# Where scores come from. Default: espn (real data, no key needed).
#   espn           ESPN's public feed. Includes crests, goalscorers and live clocks.
#   football-data  https://www.football-data.org (needs FOOTBALL_DATA_API_KEY)
#   api-football   https://www.api-football.com (needs API_FOOTBALL_KEY). A paid key covers
#                  every competition this app knows, unlike the two sources above.
#   mock           Simulated season for offline work. Never use in production.
SPORTS_DATA_PROVIDER=espn

# Only for SPORTS_DATA_PROVIDER=football-data
FOOTBALL_DATA_API_KEY=

# Only for SPORTS_DATA_PROVIDER=api-football
API_FOOTBALL_KEY=

# ---------- Site ----------
# Public base URL. Required in production: it is used for email links, auth redirects,
# trusted origins and the sitemap. Leave unset locally so any localhost port works.
NEXT_PUBLIC_APP_URL=

# ---------- Accounts ----------
# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Romania, Moldova and Ukraine come from TheSportsDB, which ESPN does not cover.
# Optional: without a key its public test key is used (about 30 requests a minute, so the
# first table after a cold start takes a while to build). A Patreon key lifts that limit.
THESPORTSDB_API_KEY=
# Where its answers are kept between restarts. Default: apps/web/data/cache/thesportsdb.
TSDB_CACHE_DIR=

# ---------- Admin console (/admin) ----------
# The first admin account. Created on first visit to /admin/login if it does not exist.
# In development, leaving these empty enables the demo login admin@pitchside.app / pitchside.
# In production there is no fallback: without both values nobody can open the console.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Photos uploaded in the article editor. Default: apps/web/data/uploads (git-ignored, next to
# the local database). On a host without a persistent disk, point this at a mounted volume.
UPLOADS_DIR=

# ---------- Database (accounts and comments) ----------
# Default is a local SQLite file, created and migrated automatically on first use.
# For production point this at a hosted libSQL / Turso database.
DATABASE_URL=file:./data/pitchside.db
DATABASE_AUTH_TOKEN=

# ---------- Email (verification links) ----------
# Without SMTP_HOST, development writes emails to apps/web/data/outbox/ and logs the path.
# Production refuses to start sign-ups without SMTP, unless EMAIL_DEV_OUTBOX=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Pitchside <no-reply@example.com>"
EMAIL_DEV_OUTBOX=false

# ---------- Rate limiting ----------
# The header your proxy or CDN puts the real client address in, e.g. cf-connecting-ip.
# Default: x-real-ip, then the last entry of x-forwarded-for. Run behind a proxy that sets it.
CLIENT_IP_HEADER=
